{
  "name": "irmc-viewer",
  "version": "0.1.0",
  "description": "Web-based viewer for Fujitsu iRMC Advanced Video Redirection (Mahogany protocol). Bridges iRMC KVM to VNC/RFB over WebSocket (noVNC).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/",
    "test:e2e": "node --test test/e2e-smoke.test.js"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "better-sqlite3": "^11.10.0",
    "puppeteer-core": "^24.43.1",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  }
}
