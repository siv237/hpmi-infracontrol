# ============================================================================
# Шаблон конфигурации деплоя приложения InfraControl
# Скопируйте в ".env" рядом с deploy.sh и заполните. ".env" в git НЕ попадает.
# deploy.sh читает ".env" из каталога скрипта (или укажите свой:
#   DEPLOY_ENV=/path/to/env ./deploy.sh)
# Все значения ниже — заглушки, реальные подставляйте в своём ".env".
# ============================================================================

# ---- Целевой сервер (SSH) -------------------------------------------------
DEPLOY_HOST=root@server.example.ru
# Если порт SSH нестандартный: root@host -p 22222 (см. ssh_config альтернатива)

# ---- Каталог и пользователь приложения на сервере -------------------------
APP_DIR=/opt/infracontrol
APP_USER=infracontrol                    # системный пользователь, от которого бежит сервис
APP_USER_SHELL=/usr/sbin/nologin # /bin/bash если нужен доступ в shell

# ---- Порт Node-приложения (слушает ТОЛЬКО localhost, наружу — nginx) ------
APP_PORT=1845
APP_DEBUG=0                 # 1 = диагностика смены разрешений

# ---- nginx (внешний доступ, TLS) ------------------------------------------
NGINX_ENABLED=1                  # 0 = не трогать nginx (если он уже настроен)
NGINX_SERVER_NAME=infracontrol.example.ru       # имя, на которое отвечает nginx
NGINX_HTTP_REDIRECT=1            # 1 = слушать :80 и редиректить на https
NGINX_CERTS_DIR=/etc/nginx/certs # куда положить свои сертификаты на сервере
# Пока работаем с самоподписанным сертификатом (openssl есть на сервере):
NGINX_SELF_SIGNED=1              # 1 = deploy сам генерирует cert+key в NGINX_CERTS_DIR
NGINX_CERT=${NGINX_CERTS_DIR}/infracontrol.crt      # итоговые пути (hint; правятся в deploy)
NGINX_CERT_KEY=${NGINX_CERTS_DIR}/infracontrol.key

# ---- Доставка зависимостей (сервер офлайн, npm-репозитория нет) -----------
# Основной способ: готовый node_modules с машины-разработчика. ABI нативного
# модуля better-sqlite3 обязан совпадать с версией Node на сервере.
#   SHIP_NODE_MODULES=1  -> загружаем ваш local node_modules (default)
#   REBUILD_SQLITE=1     -> после загрузки пересобрать better-sqlite3 на
#                           сервере из исходников (нужны gcc + заголовки Node)
SHIP_NODE_MODULES=1
REBUILD_SQLITE=1

# ---- Установка и обновление пакетов на сервере (root-сессия) --------------
INSTALL_PKGS=1                  # dnf install: nodejs npm unzip gcc gcc-c++ make nginx
INSTALL_NODEJS_DEVEL=1          # поставить nodejs-devel для офлайн-сборки better-sqlite3
